{
  "name": "memory-deck-session",
  "version": "0.5.0",
  "description": "Value Forge: search memory and organize named address groups for your running game session.",
  "type": "module",
  "license": "GPL-3.0-only",
  "scripts": {
    "build": "rollup -c",
    "typecheck": "tsc --noEmit",
    "test": "python3 -m unittest discover -s tests -v",
    "build:native": "python3 scripts/build_native.py",
    "package": "python3 scripts/package_plugin.py",
    "release": "python3 scripts/package_plugin.py --release",
    "test:ui": "node tests/test_ui.mjs",
    "check": "npm run typecheck && npm run build && npm test && npm run test:ui"
  },
  "devDependencies": {
    "@decky/rollup": "1.0.2",
    "@decky/ui": "4.15.1",
    "@testing-library/react": "16.3.0",
    "@types/react": "19.1.1",
    "@types/react-dom": "19.1.1",
    "jsdom": "26.1.0",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "rollup": "4.53.3",
    "typescript": "5.6.2"
  },
  "dependencies": {
    "@decky/api": "1.1.3",
    "tslib": "2.7.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/timekillr/value-forge-decky.git"
  },
  "homepage": "https://github.com/timekillr/value-forge-decky",
  "bugs": {
    "url": "https://github.com/timekillr/value-forge-decky/issues"
  }
}
